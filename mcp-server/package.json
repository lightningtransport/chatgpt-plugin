{
  "name": "lightning-reporting-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Read-only Lightning Transportation reporting MCP server for ChatGPT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.json",
