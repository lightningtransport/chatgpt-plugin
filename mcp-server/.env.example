# Store the assigned agent-reporting key only in your deployment secret manager.
# Never commit a real value. On Vercel, set this as a sensitive environment variable.
AGENT_REPORTING_KEY=
AGENT_REPORTING_ENDPOINT=https://aaqquwhdglueqlnbifvn.supabase.co/functions/v1/agent-reporting
NODE_ENV=development
MCP_AUTH_MODE=development
PORT=8000
REPORTING_KNOWLEDGE_ROOT=
MCP_REQUEST_TIMEOUT_MS=30000
MCP_RATE_LIMIT_RPM=60
MCP_MAX_PAGES=100

